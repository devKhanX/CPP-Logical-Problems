#include <iostream>
#include <vector>
using namespace std;
int longestSubarray(vector<int>& arr, int K) {
    int n = arr.size();
    int maxLen = 0;
    for (int i = 0; i < n; i++) {
        int sum = 0;
        for (int j = i; j < n; j++) {
            sum += arr[j];
            if (sum == K) {
                int len = j - i + 1;
                maxLen = max(maxLen, len);
            }
        }
    }
    return maxLen;
}
int main() {
    vector<int> arr = {10, 5, 2, 7, 1, 9};
    int K = 15;
    cout << longestSubarray(arr, K) << endl;
    return 0;
}
